# App Store identity. Values come from environment variables so no secrets live
# in git. See SUBMIT.md for how to obtain them.
app_identifier("com.bysubotic.quadshot")
apple_id(ENV["APPLE_ID"])            # your Apple account email (for App Store Connect)
team_id(ENV["APPLE_TEAM_ID"])        # Developer Portal Team ID (10 chars) — for signing
itc_team_id(ENV["ASC_TEAM_ID"])      # App Store Connect team id (optional; usually same)
