# Quadshot — iOS release automation (Capacitor + fastlane).
# Auth is via an App Store Connect API key (no Apple-ID password / 2FA needed).
# Set ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to AuthKey_XXXXXX.p8),
# APPLE_ID, APPLE_TEAM_ID  — see SUBMIT.md. Run from the repo root:
#   fastlane beta      # build + upload to TestFlight
#   fastlane release   # build + upload + submit for App Store review
default_platform(:ios)

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME    = "App"
APP_ID    = "com.bysubotic.quadshot"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do

  desc "Verify API-key auth + whether the app record exists"
  lane :verify do
    key = asc_key
    begin
      n = latest_testflight_build_number(api_key: key, app_identifier: APP_ID, initial_build_number: 0)
      UI.success("AUTH OK — app exists. latest TestFlight build = #{n}")
    rescue => e
      UI.important("AUTH OK — but app lookup said: #{e.message}")
    end
  end

  desc "Create the App Store Connect app record if missing"
  lane :setup_app do
    produce(
      api_key: asc_key,
      app_identifier: APP_ID,
      app_name: "Quadshot",
      language: "English",
      app_version: "1.0",
      sku: "quadshot",
      company_name: "Djordje Subotic"
    )
  end
  desc "Build web + sync Capacitor + archive a signed App Store build"
  lane :build_ipa do
    # (web build + cap sync are run in the shell BEFORE fastlane — CocoaPods
    #  breaks under fastlane's bundled Ruby env.)
    # 2) Bump the build number above whatever is already on App Store Connect.
    key = asc_key
    latest = latest_testflight_build_number(api_key: key, app_identifier: APP_ID) rescue 0
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: latest.to_i + 1)
    # 3) Archive + export (automatic signing; -allowProvisioningUpdates lets Xcode
    #    create the App Store distribution profile from the API key on first run).
    # gym auto-injects the ASC API-key auth flags from the lane context; we only
    # add -allowProvisioningUpdates so xcodebuild can create the profile + App ID.
    auth = "-allowProvisioningUpdates"
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      output_name: "Quadshot.ipa",
      xcargs: auth,
      export_xcargs: auth,
      export_options: { signingStyle: "automatic", teamID: "YMN45WC2QR" }
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    build_ipa
    upload_to_testflight(api_key: asc_key, skip_waiting_for_build_processing: true)
  end

  desc "Re-upload the ipa already in build/ (no rebuild)"
  # Apple's uploader returns a 500 often enough to matter, and a rebuild would
  # burn another build number for a transfer that never reached them. The
  # archive from the failed `beta` run is still valid — just send it again.
  lane :beta_upload do
    upload_to_testflight(
      api_key: asc_key,
      ipa: "build/Quadshot.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  # Answers Apple asks at submission time. The app serves AdMob ads and calls
  # ATT, so IDFA use is "yes / serves ads" — claiming otherwise is a false
  # privacy answer, not a shortcut. It attributes nothing itself (no install or
  # action attribution of its own), and it honours Limit Ad Tracking: every ad
  # request falls back to npa=1 when ATT is not authorised (see Monetization).
  SUBMISSION_INFO = {
    export_compliance_uses_encryption: false,
    add_id_info_uses_idfa: true,
    add_id_info_serves_ads: true,
    add_id_info_tracks_action: false,
    add_id_info_tracks_install: false,
    add_id_info_limits_tracking: true,
  }

  desc "Upload + submit for App Store review"
  lane :release do
    build_ipa
    upload_to_app_store(
      api_key: asc_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,                       # skip the HTML metadata preview prompt
      precheck_include_in_app_purchases: false,
      submission_information: SUBMISSION_INFO
    )
  end

  desc "Push metadata + screenshots and submit a build that is ALREADY on TestFlight"
  # Rebuilding to submit would ship a binary nobody has played. This submits the
  # exact build that was tested: pass BUILD_NUMBER (and VERSION for the train).
  lane :submit_existing do
    upload_to_app_store(
      api_key: asc_key,
      app_version: ENV.fetch("VERSION"),
      build_number: ENV.fetch("BUILD_NUMBER"),
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: SUBMISSION_INFO
    )
  end
end
